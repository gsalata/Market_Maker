# ============================================
# Polymarket Market Maker - Environment Config
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your .env file to git!

# ============================================
# Wallet (REQUIRED for live trading)
# ============================================
# Your Ethereum/Polygon private key (with 0x prefix)
# This signs orders and derives API credentials
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Optional: Polymarket proxy wallet address
# Only needed if you use a Gnosis Safe / proxy wallet
# PROXY_ADDRESS=0xYOUR_PROXY_ADDRESS

# Polygon chain ID (137 = mainnet, 80001 = Mumbai testnet)
CHAIN_ID=137

# ============================================
# CLOB API Credentials
# ============================================
# Run `npm run generate-key` to create these.
# Once generated, paste the values here so you
# don't re-derive on every startup.
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=

# ============================================
# Paper Trading Mode
# ============================================
# Set to true to trade with fake money (no wallet needed)
PAPER_TRADING=false

# Starting balance for paper trading (USD)
PAPER_TRADING_BALANCE=100000

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# API Endpoints (defaults are fine for mainnet)
# ============================================
POLYMARKET_CLOB_ENDPOINT=https://clob.polymarket.com
POLYMARKET_GAMMA_ENDPOINT=https://gamma-api.polymarket.com
POLYMARKET_DATA_ENDPOINT=https://data-api.polymarket.com

# ============================================
# Market Making Strategy
# ============================================
# Spread in basis points (100 bps = 1%)
DEFAULT_SPREAD_BPS=50

# Order size per side in USD
DEFAULT_ORDER_SIZE_USD=10

# Maximum position size per market in USD
MAX_POSITION_SIZE_USD=100

# Inventory imbalance threshold (0.0 to 1.0)
MAX_INVENTORY_IMBALANCE=0.6

# How often to refresh quotes (milliseconds)
ORDER_REFRESH_INTERVAL_MS=5000

# Maximum orders per market
MAX_ORDERS_PER_MARKET=4

# ============================================
# Risk Management
# ============================================
ENABLE_RISK_LIMITS=true
MAX_TOTAL_EXPOSURE_USD=1000
MAX_POSITION_PER_MARKET_USD=200

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
