# ============================================
# Paper Trading Configuration Template
# ============================================
# Copy this file to .env and modify as needed

# Enable Paper Trading Mode (true/false)
PAPER_TRADING=true

# Starting balance for paper trading (USD)
PAPER_TRADING_BALANCE=100000

# ============================================
# Dummy API Credentials (not used in paper trading)
# ============================================
PRIVATE_KEY=0x1234567890123456789012345678901234567890123456789012345678901234

# CLOB API credentials (not needed for paper trading)
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# Market Making Strategy
# ============================================
# Spread in basis points (100 bps = 1%)
DEFAULT_SPREAD_BPS=50

# Order size in USD
DEFAULT_ORDER_SIZE_USD=100

# Maximum position size per market in USD
MAX_POSITION_SIZE_USD=10000

# Inventory imbalance threshold (0.0 to 1.0)
MAX_INVENTORY_IMBALANCE=0.6

# Order refresh interval in milliseconds
ORDER_REFRESH_INTERVAL_MS=5000

# Maximum orders per market
MAX_ORDERS_PER_MARKET=4

# ============================================
# Risk Management
# ============================================
# Enable risk limits (true/false)
ENABLE_RISK_LIMITS=true

# Maximum total exposure in USD
MAX_TOTAL_EXPOSURE_USD=50000

# Maximum position per market in USD
MAX_POSITION_PER_MARKET_USD=10000

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
